__pycache__/
.venv/
*.pyc
.pytest_cache/

# Restos de empaquetado
*.egg-info/
build/
dist/

# Facturas de terceros descargadas para probar. No son nuestras.
muestras/
MuestrasFE/
Pfactura3/

# Los esquemas XSD oficiales: son de sus organismos y pesan 3,8 MB.
esquemas/

# Las anclas de confianza. No se versionan a proposito, y no por tamanio:
# quien controle ese fichero controla a quien cree el validador. Las instala
# quien usa la herramienta y las contrasta con `--ver-anclas`.
#
# El patron lleva comodin porque las de sellado van en una carpeta hermana
# —`anclas-sellos/`— y `anclas/` a secas no la cubre: sin el comodin, la
# primera vez que alguien montara el conjunto se le versionarian 120
# certificados de autoridades de sellado sin enterarse.
anclas/
anclas-*/

# Las listas de revocacion. Estas no deciden en quien se confia, pero caducan
# y hay que renovarlas: versionarlas seria repartir una foto vieja de quien
# esta anulado, que es justo lo que no sirve.
revocaciones/

# Las listas de confianza que se bajen para montar el conjunto de anclas. La
# espanola pesa 2,8 MB y caduca; lo que hay que conservar no es el fichero,
# sino la carpeta que sale de el y su PROCEDENCIA.txt.
listas/

# El paquete que se lleva la pagina SI se versiona, y es la unica excepcion a
# la regla de arriba. Estuvo fuera mientras la pagina se servia en local: alli
# cada uno armaba el suyo desde sus carpetas. Al publicarla dejo de tener
# sentido, porque el sitio se construye desde este repositorio y sin el zip
# comprobaria el contenido y nada mas.
#
# La regla no se rompe: el motivo de no versionar anclas es que quien controle
# ese fichero controla en quien cree el validador, y publicar la pagina ya las
# reparte igual. Lo que hay que poder hacer es contrastarlas, y para eso va el
# SHA-256 en PAQUETE.json, dentro del zip y fuera, y a la vista en la pagina.
#
# Lo que si sigue fuera son las carpetas de las que sale —esquemas/, anclas/ y
# anclas-*/—: el zip es lo que se reparte, no la materia prima.
#
# Hay que rehacerlo cada vez que se renueve la lista de confianza, ~6 meses.
# Si se olvida, el propio validador lo dice: ANCLAS-SIN-RENOVAR sale en cada
# informe y en el recuadro de la pagina.

# Lo que se sube a la web. Se monta desde aqui con `python -m validador
# --sitio`, asi que versionarlo seria guardar una copia de lo que ya hay,
# con el riesgo de que se quede vieja y nadie lo note.
sitio/

__pycache__/
.venv/
*.pyc
.pytest_cache/

# Restos de empaquetado
*.egg-info/
build/
dist/

# Facturas de terceros descargadas para probar. No son nuestras.
muestras/
MuestrasFE/

# Los esquemas XSD oficiales: son de sus organismos y pesan 3,8 MB.
esquemas/

# Las anclas de confianza. No se versionan a proposito, y no por tamanio:
# quien controle ese fichero controla a quien cree el validador. Las instala
# quien usa la herramienta y las contrasta con `--ver-anclas`.
anclas/

# Las listas de revocacion. Estas no deciden en quien se confia, pero caducan
# y hay que renovarlas: versionarlas seria repartir una foto vieja de quien
# esta anulado, que es justo lo que no sirve.
revocaciones/

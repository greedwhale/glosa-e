{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'sin dependencias de node'",
  "buildCommand": "python3 -m pip install --quiet --disable-pip-version-check --break-system-packages lxml && python3 -m pip wheel . --no-deps --wheel-dir dist && python3 -m validador --traer-pyodide && python3 -m validador --sitio sitio",
  "outputDirectory": "sitio",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/pyodide/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/dist/(.*).whl",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/ejemplos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/paquete.zip",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/PAQUETE.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/prueba.py",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/glosa.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/glosa.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/dist/rueda.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
